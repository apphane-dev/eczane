---
import type { CityData } from "../lib/types";
import { groupByDistrict } from "../lib/pharmacy";
import {
  locales,
  type Locale,
  translations,
  formatUpdatedAt,
  getIntlLocale,
  cityPath,
} from "../lib/i18n";
import PharmacyCard from "./PharmacyCard.astro";
import MapView from "./MapView.astro";
import antalyaData from "../data/antalya.json";
import "../styles/global.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];

const data = antalyaData as CityData;
const groups = groupByDistrict(data.pharmacies);
const updated = formatUpdatedAt(data.updatedAt, locale);
const total = data.pharmacies.length;
const site = Astro.site?.origin ?? "";

// Strings needed by the client-side script (geolocation UI).
const runtimeStrings = {
  intlLocale: getIntlLocale(locale),
  distanceSuffix: t.distanceSuffix,
  locate: t.locate,
  locating: t.locating,
  locateSorted: t.locateSorted,
  locateFailed: t.locateFailed,
  locateUnsupported: t.locateUnsupported,
  showGrouped: t.showGrouped,
  nearestAnnounce: t.nearestAnnounce(total),
  groupedAnnounce: t.groupedAnnounce,
};
---

<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t.metaDescription} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta
      name="theme-color"
      content="#f7f3ec"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0c1420"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />
    <meta name="apple-mobile-web-app-title" content="Eczane" />
    <title>{t.pageTitle}</title>
    <link rel="canonical" href={`${site}${cityPath(locale)}`} />
    {
      locales.map((loc) => (
        <link
          rel="alternate"
          hreflang={translations[loc].htmlLang}
          href={`${site}${cityPath(loc)}`}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${site}${cityPath("tr")}`}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-header__top">
          <h1 class="site-header__title">
            <span class="cross" aria-hidden="true">+</span>
            {t.pageTitle}
          </h1>
          <nav class="lang" aria-label={t.languageLabel}>
            {
              locales.map((loc) => (
                <a
                  href={cityPath(loc)}
                  hreflang={translations[loc].htmlLang}
                  lang={translations[loc].htmlLang}
                  aria-current={loc === locale ? "true" : undefined}
                  class:list={["lang__link", { "lang__link--active": loc === locale }]}
                >
                  {translations[loc].htmlLang.toUpperCase()}
                </a>
              ))
            }
          </nav>
        </div>
        <p class="site-header__meta">
          {t.onDutyCount(total)} · {t.lastUpdated}: {updated}
        </p>
      </div>
    </header>

    <div class="toolbar">
      <div class="toolbar__inner">
        <div class="toggle" role="group" aria-label={t.viewGroupLabel}>
          <button id="view-list-btn" aria-pressed="true">{t.viewList}</button>
          <button id="view-map-btn" aria-pressed="false">{t.viewMap}</button>
        </div>
        <button id="locate-btn" class="btn-locate">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle
              cx="12"
              cy="12"
              r="4"
              stroke="currentColor"
              stroke-width="2"
            />
            <path
              d="M12 2v3M12 19v3M2 12h3M19 12h3"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          <span class="btn-locate__label">{t.locate}</span>
        </button>
      </div>
    </div>

    <main>
      <p id="status" class="sr-only" role="status" aria-live="polite"></p>
      <section id="view-list" class="view" aria-label={t.listAriaLabel}>
        <div id="grouped">
          {
            groups.map((group) => (
              <div class="district">
                <div class="district__head">
                  <h2 class="district__name">{group.district}</h2>
                  <span class="district__count">{group.pharmacies.length}</span>
                </div>
                <div class="cards">
                  {group.pharmacies.map((pharmacy) => (
                    <PharmacyCard pharmacy={pharmacy} t={t} />
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div id="nearest" hidden>
          <div class="district__head">
            <h2 class="district__name">{t.nearestHeading}</h2>
            <span class="district__count" id="nearest-count"></span>
          </div>
          <div class="cards" id="nearest-cards"></div>
        </div>
      </section>

      <section id="view-map" class="view" hidden aria-label={t.mapAriaLabel}>
        <MapView
          pharmacies={data.pharmacies}
          t={t}
          intlLocale={getIntlLocale(locale)}
        />
      </section>
    </main>

    <footer class="site-footer">
      <p>{t.footer}</p>
    </footer>

    <dialog
      id="directions-dialog"
      class="sheet"
      aria-labelledby="directions-dialog-title"
    >
      <div class="sheet__panel">
        <div class="sheet__handle" aria-hidden="true"></div>
        <div class="sheet__head">
          <h2 id="directions-dialog-title" class="sheet__title">
            {t.directionsChooser}
          </h2>
          <button
            type="button"
            class="sheet__close"
            data-directions-close
            aria-label={t.close}
          >
            ×
          </button>
        </div>
        <div class="sheet__options">
          <a
            class="sheet__option"
            data-provider="google"
            target="_blank"
            rel="noopener"
          >
            {t.directionsGoogle}
          </a>
          <a
            class="sheet__option"
            data-provider="yandex"
            target="_blank"
            rel="noopener"
          >
            {t.directionsYandex}
          </a>
          <a
            class="sheet__option"
            data-provider="osm"
            target="_blank"
            rel="noopener"
          >
            {t.directionsOsm}
          </a>
        </div>
      </div>
    </dialog>

    <script
      id="i18n-strings"
      type="application/json"
      set:html={JSON.stringify(runtimeStrings)}
    />

    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>

    <script>
      interface RuntimeStrings {
        intlLocale: string;
        distanceSuffix: string;
        locate: string;
        locating: string;
        locateSorted: string;
        locateFailed: string;
        locateUnsupported: string;
        showGrouped: string;
        nearestAnnounce: string;
        groupedAnnounce: string;
      }

      const S: RuntimeStrings = JSON.parse(
        document.getElementById("i18n-strings")?.textContent || "{}",
      );

      // --- View toggle ---
      const listBtn = document.getElementById("view-list-btn")!;
      const mapBtn = document.getElementById("view-map-btn")!;
      const listView = document.getElementById("view-list")!;
      const mapView = document.getElementById("view-map")!;

      function setView(view: "list" | "map") {
        const isMap = view === "map";
        listView.hidden = isMap;
        mapView.hidden = !isMap;
        listBtn.setAttribute("aria-pressed", String(!isMap));
        mapBtn.setAttribute("aria-pressed", String(isMap));
        // On mobile, the map view is a full-height flex column with no page
        // scroll (see body.map-view in global.css); the list view keeps normal
        // document flow. The class is inert above 819px.
        document.body.classList.toggle("map-view", isMap);
        // Nudge MapLibre to recompute size when it becomes visible.
        window.dispatchEvent(new Event("resize"));
      }

      listBtn.addEventListener("click", () => setView("list"));
      mapBtn.addEventListener("click", () => setView("map"));

      // --- Directions picker (bottom sheet on mobile, modal on desktop) ---
      const directionsDialog = document.getElementById(
        "directions-dialog",
      ) as HTMLDialogElement | null;
      const providerLinks = {
        google: directionsDialog?.querySelector<HTMLAnchorElement>(
          '[data-provider="google"]',
        ),
        yandex: directionsDialog?.querySelector<HTMLAnchorElement>(
          '[data-provider="yandex"]',
        ),
        osm: directionsDialog?.querySelector<HTMLAnchorElement>(
          '[data-provider="osm"]',
        ),
      };
      let directionsTrigger: HTMLElement | null = null;

      function closeDirections() {
        if (!directionsDialog?.open) return;
        if (typeof directionsDialog.close === "function") {
          directionsDialog.close();
        } else {
          directionsDialog.removeAttribute("open");
          directionsTrigger?.focus();
          directionsTrigger = null;
        }
      }

      function openDirections(trigger: HTMLElement) {
        if (!directionsDialog) return;
        const google = trigger.dataset.google || "";
        const yandex = trigger.dataset.yandex || "";
        const osm = trigger.dataset.osm || "";
        if (!google && !yandex && !osm) return;

        if (providerLinks.google) providerLinks.google.href = google;
        if (providerLinks.yandex) providerLinks.yandex.href = yandex;
        if (providerLinks.osm) providerLinks.osm.href = osm;

        directionsTrigger = trigger;
        if (typeof directionsDialog.showModal === "function") {
          directionsDialog.showModal();
        } else {
          directionsDialog.setAttribute("open", "");
        }
        providerLinks.google?.focus();
      }

      document.addEventListener("click", (ev) => {
        const target = ev.target as HTMLElement | null;
        if (!target) return;

        const trigger = target.closest<HTMLElement>("[data-directions]");
        if (trigger) {
          ev.preventDefault();
          openDirections(trigger);
          return;
        }

        if (target.closest("[data-directions-close]")) {
          closeDirections();
          return;
        }

        if (
          directionsDialog?.open &&
          target === directionsDialog
        ) {
          // Click on the backdrop (outside the panel).
          closeDirections();
        }
      });

      directionsDialog?.addEventListener("close", () => {
        directionsTrigger?.focus();
        directionsTrigger = null;
      });

      document.addEventListener("keydown", (ev) => {
        if (ev.key === "Escape" && directionsDialog?.open) {
          closeDirections();
        }
      });

      directionsDialog
        ?.querySelectorAll<HTMLAnchorElement>(".sheet__option")
        .forEach((link) => {
          link.addEventListener("click", () => {
            // Let the browser navigate, then dismiss the picker.
            closeDirections();
          });
        });

      // --- Geolocation distance (haversine) ---
      function haversineKm(
        lat1: number,
        lon1: number,
        lat2: number,
        lon2: number,
      ): number {
        const R = 6371;
        const dLat = ((lat2 - lat1) * Math.PI) / 180;
        const dLon = ((lon2 - lon1) * Math.PI) / 180;
        const a =
          Math.sin(dLat / 2) ** 2 +
          Math.cos((lat1 * Math.PI) / 180) *
            Math.cos((lat2 * Math.PI) / 180) *
            Math.sin(dLon / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      const locateBtn = document.getElementById(
        "locate-btn",
      ) as HTMLButtonElement;
      const groupedEl = document.getElementById("grouped")!;
      const nearestEl = document.getElementById("nearest")!;
      const nearestCards = document.getElementById("nearest-cards")!;
      const nearestCount = document.getElementById("nearest-count")!;
      const statusEl = document.getElementById("status")!;
      const locateIcon =
        '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
        '<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>' +
        '<path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>' +
        "</svg> ";

      const kmFmt = new Intl.NumberFormat(S.intlLocale, {
        style: "unit",
        unit: "kilometer",
        maximumFractionDigits: 1,
      });

      // Remember each card's home district container and DOM order so the
      // grouped view can be restored exactly when nearest mode is cleared.
      const cardHome = Array.from(
        groupedEl.querySelectorAll<HTMLElement>(".card"),
      ).map((card) => ({ card, parent: card.parentElement! }));

      let nearestActive = false;

      function setDistances(lat: number, lng: number): HTMLElement[] {
        const ranked: { card: HTMLElement; d: number }[] = [];
        for (const { card } of cardHome) {
          const clat = parseFloat(card.dataset.lat || "");
          const clng = parseFloat(card.dataset.lng || "");
          const row = card.querySelector<HTMLElement>(".card__distance");
          const value = card.querySelector<HTMLElement>(".card__distance-value");
          if (Number.isNaN(clat) || Number.isNaN(clng) || !row || !value) {
            // No coordinates: sort such cards to the end.
            ranked.push({ card, d: Infinity });
            continue;
          }
          const d = haversineKm(lat, lng, clat, clng);
          value.textContent = `${kmFmt.format(d)} ${S.distanceSuffix}`;
          row.hidden = false;
          card.dataset.distance = String(d);
          ranked.push({ card, d });
        }
        ranked.sort((a, b) => a.d - b.d);
        return ranked.map((r) => r.card);
      }

      // Flatten into a single city-wide distance-ordered list. `broadcast`
      // controls whether the shared nearest-mode event is emitted (false when
      // we are reacting to that event coming from the map).
      function enterNearest(lat: number, lng: number, broadcast = true) {
        const sorted = setDistances(lat, lng);
        for (const card of sorted) nearestCards.appendChild(card);
        nearestCount.textContent = String(sorted.length);
        groupedEl.hidden = true;
        nearestEl.hidden = false;
        nearestActive = true;
        locateBtn.disabled = false;
        locateBtn.innerHTML = locateIcon + S.showGrouped;
        locateBtn.setAttribute("aria-pressed", "true");
        statusEl.textContent = S.nearestAnnounce;
        if (broadcast) {
          window.dispatchEvent(
            new CustomEvent("nearest:sync", {
              detail: { active: true, lat, lng, source: "list" },
            }),
          );
        }
      }

      // Restore the district grouping in its original order.
      function exitNearest(broadcast = true) {
        for (const { card, parent } of cardHome) {
          const row = card.querySelector<HTMLElement>(".card__distance");
          if (row) row.hidden = true;
          parent.appendChild(card);
        }
        nearestEl.hidden = true;
        groupedEl.hidden = false;
        nearestActive = false;
        locateBtn.innerHTML = locateIcon + S.locate;
        locateBtn.setAttribute("aria-pressed", "false");
        statusEl.textContent = S.groupedAnnounce;
        if (broadcast) {
          window.dispatchEvent(
            new CustomEvent("nearest:sync", {
              detail: { active: false, source: "list" },
            }),
          );
        }
      }

      // Keep the list in sync when nearest mode is toggled from the map's own
      // geolocate control. Ignore our own broadcasts to avoid a feedback loop.
      window.addEventListener("nearest:sync", (ev) => {
        const d = (ev as CustomEvent).detail as {
          active: boolean;
          lat?: number;
          lng?: number;
          source: string;
        };
        if (d.source === "list") return;
        if (d.active && !nearestActive && d.lat != null && d.lng != null) {
          enterNearest(d.lat, d.lng, false);
        } else if (!d.active && nearestActive) {
          exitNearest(false);
        }
      });

      locateBtn.setAttribute("aria-pressed", "false");
      locateBtn.addEventListener("click", () => {
        if (nearestActive) {
          exitNearest();
          return;
        }
        if (!navigator.geolocation) {
          locateBtn.textContent = S.locateUnsupported;
          locateBtn.disabled = true;
          return;
        }
        locateBtn.disabled = true;
        locateBtn.innerHTML = locateIcon + S.locating;
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            enterNearest(pos.coords.latitude, pos.coords.longitude);
          },
          () => {
            locateBtn.disabled = false;
            locateBtn.innerHTML = locateIcon + S.locateFailed;
          },
          { enableHighAccuracy: true, timeout: 8000, maximumAge: 60000 },
        );
      });
    </script>
  </body>
</html>
