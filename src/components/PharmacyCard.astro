---
import type { Pharmacy } from "../lib/types";
import type { Strings } from "../lib/i18n";
import {
  formatPhone,
  telHref,
  whatsappHref,
  isMobilePhone,
  googleMapsHref,
  yandexMapsHref,
  googleSearchHref,
} from "../lib/pharmacy";

interface Props {
  pharmacy: Pharmacy;
  t: Strings;
}

const { pharmacy, t } = Astro.props;
const { name, address, phone, coordinates } = pharmacy;
const mapQuery = `${name} ${address}`;
---

<article
  class:list={["card", { "card--no-coords": !coordinates }]}
  data-name={name}
  data-address={address}
  data-phone={phone ?? ""}
  data-lat={coordinates?.lat ?? ""}
  data-lng={coordinates?.lng ?? ""}
>
  <div class="card__head">
    <h3 class="card__name">{name}</h3>
    <span class="card__district">{pharmacy.district}</span>
  </div>
  <p class="card__address">{address}</p>

  <p class="card__distance" hidden>
    <span class="card__distance-icon" aria-hidden="true">📍</span>
    <span class="card__distance-value"></span>
  </p>

  <div class="card__actions">
    {
      phone && (
        <a
          class="btn btn--call"
          href={telHref(phone)}
          aria-label={`${t.call}: ${formatPhone(phone)}`}
        >
          <span aria-hidden="true">📞</span> {formatPhone(phone)}
        </a>
      )
    }
    {
      phone && isMobilePhone(phone) && (
        <a
          class="btn btn--whatsapp"
          href={whatsappHref(phone)}
          target="_blank"
          rel="noopener"
        >
          <span aria-hidden="true">💬</span> {t.whatsapp}
        </a>
      )
    }
    {
      coordinates ? (
        <>
          <a
            class="btn btn--map"
            href={googleMapsHref(coordinates.lat, coordinates.lng)}
            target="_blank"
            rel="noopener"
          >
            {t.directionsGoogle}
          </a>
          <a
            class="btn btn--map"
            href={yandexMapsHref(coordinates.lat, coordinates.lng)}
            target="_blank"
            rel="noopener"
          >
            {t.directionsYandex}
          </a>
        </>
      ) : (
        <a
          class="btn btn--map"
          href={googleSearchHref(mapQuery)}
          target="_blank"
          rel="noopener"
        >
          {t.searchOnMap}
        </a>
      )
    }
  </div>
</article>
